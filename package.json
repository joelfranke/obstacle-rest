{
  "name": "goliathon-rest-api",
  "version": "1.1.0",
  "description": "A RESTful API to POST and GET results and participant data for Goliathon events",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "g8:local": "npx --yes serve server/reporting/scoring/g8 -l 5173 --no-port-switching",
    "g8:dev": "node server/reporting/scoring/g8/dev-server.js",
    "prepare": "node scripts/install-git-hook.js",
    "test:event": "node scripts/event-day-check.js",
    "test:event:local": "node scripts/event-day-check.js --target local",
    "test:event:dev": "node scripts/event-day-check.js --target dev",
    "test:event:prod": "node scripts/event-day-check.js --target prod",
    "test:event:prove-node": "node scripts/event-day-check.js --prove-node"
  },
  "engines": {
    "node": "18.x"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.3.0",
    "compression": "^1.7.2",
    "date-and-time": "^4.6.0",
    "express": "^5.2.1",
    "lodash": "^4.15.0",
    "mongodb": "^7",
    "mongoose": ">=5.12.10"
  }
}
